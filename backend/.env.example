# PostgreSQL на Railway — вставь сюда строку подключения (External URL)
# Пример: postgresql://postgres:PASSWORD@host.proxy.rlwy.net:PORT/railway
DATABASE_URL=

# Ключ OpenAI для Vision (gpt-4o) и embeddings (text-embedding-3-small)
OPENAI_API_KEY=

# Необязательно: модели можно переопределить
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small
